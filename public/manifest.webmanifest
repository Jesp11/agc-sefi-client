{
  "name": "AGC Servicios Financieros",
  "short_name": "AGC SEFI",
  "description": "App de cobranza y gestión para asesores de AGC Servicios Financieros",
  "start_url": "/dashboard/reportes/diario",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#dc2626",
  "orientation": "portrait-primary",
